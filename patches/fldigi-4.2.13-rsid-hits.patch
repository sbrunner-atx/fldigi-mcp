+
+// =====================================================================
+// rsid.* : RSID bursts heard by the detector (fldigi-mcp patch, 16 Sep 2026).
+// With RSID in notify-only mode the modem never changes; these methods let an
+// external program still learn which modes were announced, and where.
+// =====================================================================
 
+#include "rsid.h"
+
+class Rsid_get_hits : public xmlrpc_c::method
+{
+public:
+	Rsid_get_hits()
+	{
+		_signature = "A:n";
+		_help = "Returns the RSID bursts accepted by the detector since rsid.clear, as an "
+			"array of structs {utc:int (epoch seconds), mode:string (modem name as "
+			"modem.set_by_name takes it), hz:double (audio frequency)}. Works with RSID "
+			"in notify-only mode, so the modem need not change for the mode to be known. "
+			"Oldest entries drop after 1000.";
+	}
+	void execute(const xmlrpc_c::paramList& params, xmlrpc_c::value* retval)
+	{
+		std::vector<rsid_hit_t> hits;
+		rsid_hits_get(hits);
+		std::vector<xmlrpc_c::value> out;
+		for (size_t i = 0; i < hits.size(); i++) {
+			std::map<std::string, xmlrpc_c::value> item;
+			item["utc"] = xmlrpc_c::value_int((int)hits[i].utc);
+			item["mode"] = xmlrpc_c::value_string(hits[i].mode);
+			item["hz"] = xmlrpc_c::value_double(hits[i].hz);
+			out.push_back(xmlrpc_c::value_struct(item));
+		}
+		*retval = xmlrpc_c::value_array(out);
+	}
+};
+
+class Rsid_clear : public xmlrpc_c::method
+{
+public:
+	Rsid_clear()
+	{
+		_signature = "n:n";
+		_help = "Forgets the RSID bursts rsid.get_hits would return.";
+	}
+	void execute(const xmlrpc_c::paramList& params, xmlrpc_c::value* retval)
+	{
+		rsid_hits_clear();
+		*retval = xmlrpc_c::value_nil();
+	}
+};
