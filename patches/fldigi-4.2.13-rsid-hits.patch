+// rsid.get_hits (fldigi-mcp patch, 16 Sep 2026): every RSID burst the detector
+// accepted, kept for an external program to read over XML-RPC. Independent of
+// rsid_notify_only, so a program can let RSID report modes without ever switching
+// the modem and still learn what was heard.
+#include <deque>
+#include <ctime>
+#include <mutex>
+static std::deque<rsid_hit_t> rsid_hit_log;
+static std::mutex rsid_hit_mx;
+
+void rsid_hits_get(std::vector<rsid_hit_t>& out)
+{
+	std::lock_guard<std::mutex> lk(rsid_hit_mx);
+	out.assign(rsid_hit_log.begin(), rsid_hit_log.end());
+}
+
+void rsid_hits_clear()
+{
+	std::lock_guard<std::mutex> lk(rsid_hit_mx);
+	rsid_hit_log.clear();
+}
 
+static void rsid_hit_record(int mbin, double hz)
+{
+	rsid_hit_t h;
+	h.utc = (long)time(NULL);
+	h.mode = mode_info[mbin].sname;
+	h.hz = hz;
+	std::lock_guard<std::mutex> lk(rsid_hit_mx);
+	rsid_hit_log.push_back(h);
+	if (rsid_hit_log.size() > 1000)
+		rsid_hit_log.pop_front();
+}
+
