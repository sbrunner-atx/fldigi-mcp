--- a/src/network/xmlrpc.cxx
+++ b/src/network/xmlrpc.cxx
@@ -3496,7 +3496,94 @@
 };
 
 // =============================================================================
+
+
+// =====================================================================
+// browser.* : the Signal Browser (multi-channel decoder bank) over XML-RPC.
+//
+// mainViewer (main window) and brwsViewer (View > Signal browser) hold, per
+// channel, the audio frequency and the text decoded there.  These methods
+// expose that state so an external program can see every station the decoder
+// bank has locked to.  The snapshot is taken on the GUI thread (REQ_SYNC)
+// because the viewer thread writes the widget lines.
+// =====================================================================
+
+#include "Viewer.h"
+#include "viewpsk.h"
 
+struct browser_channel_t { int channel; int freq; bool active; std::string text; };
+
+static void browser_snapshot(std::vector<browser_channel_t>* out)
+{
+	pskBrowser* b = mainViewer ? mainViewer : brwsViewer;
+	if (!b) return;
+	for (int i = 1; i <= MAXCHANNELS; i++) {
+		std::string t = b->api_text(i);
+		bool active = b->api_active(i);
+		if (t.empty() && !active) continue;
+		browser_channel_t c;
+		c.channel = i;
+		c.freq = b->api_freq(i);
+		c.active = active;
+		c.text = t;
+		out->push_back(c);
+	}
+}
+
+class Browser_get_channels : public xmlrpc_c::method
+{
+public:
+	Browser_get_channels()
+	{
+		_signature = "A:n";
+		_help = "Returns the Signal Browser channels as an array of structs "
+			"{channel, freq, active, text}: channel number, audio frequency in Hz, "
+			"whether the channel currently has a signal, and all text decoded there "
+			"since browser.clear (not trimmed to the widget width; a newline marks "
+			"where the channel lost and regained a signal). Empty when no browser "
+			"widget exists or nothing has been decoded.";
+	}
+	void execute(const xmlrpc_c::paramList& params, xmlrpc_c::value* retval)
+	{
+		XMLRPC_LOCK;
+		std::vector<browser_channel_t> chans;
+		REQ_SYNC(browser_snapshot, &chans);
+		std::vector<xmlrpc_c::value> out;
+		for (size_t i = 0; i < chans.size(); i++) {
+			std::map<std::string, xmlrpc_c::value> item;
+			item["channel"] = xmlrpc_c::value_int(chans[i].channel);
+			item["freq"] = xmlrpc_c::value_int(chans[i].freq);
+			item["active"] = xmlrpc_c::value_boolean(chans[i].active);
+			item["text"] = xmlrpc_c::value_string(chans[i].text);
+			out.push_back(xmlrpc_c::value_struct(item));
+		}
+		*retval = xmlrpc_c::value_array(out);
+	}
+};
+
+static void browser_clear_all(void)
+{
+	if (mainViewer) mainViewer->clear();
+	if (brwsViewer) brwsViewer->clear();
+}
+
+class Browser_clear : public xmlrpc_c::method
+{
+public:
+	Browser_clear()
+	{
+		_signature = "n:n";
+		_help = "Clears the text of every Signal Browser channel, on screen and in the "
+			"buffer browser.get_channels reads.";
+	}
+	void execute(const xmlrpc_c::paramList& params, xmlrpc_c::value* retval)
+	{
+		XMLRPC_LOCK;
+		REQ(browser_clear_all);
+		*retval = xmlrpc_c::value_nil();
+	}
+};
